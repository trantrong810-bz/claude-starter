#!/usr/bin/env bash
# Git hook: block what must not be committed per docs/GIT.md, format staged files. Enable: git config core.hooksPath .githooks
fail=0
staged=$(git diff --cached --name-only --diff-filter=ACMR)

# .env* (except .env.example), Claude's local flags and state
bad=$(printf '%s\n' "$staged" | grep -E '(^|/)\.env($|\.)|(^|/)CLAUDE\.local\.md$|^\.claude/(\.allow-red|state/)' | grep -vE '(^|/)\.env\.example$')
if [ -n "$bad" ]; then
  echo "Do not commit local/secret files:" >&2
  printf '  %s\n' $bad >&2
  fail=1
fi

# Leftover merge conflict markers
if git diff --cached -U0 | grep -qE '^\+(<<<<<<<|>>>>>>>)( |$)|^\+=======$'; then
  echo "Merge conflict markers (<<<<<<< / ======= / >>>>>>>) left in staged files." >&2
  fail=1
fi

# main only accepts changes through GitHub PRs; commits on a local main could never be pushed.
branch=$(git branch --show-current)
if [ "$branch" = "main" ]; then
  echo "main only accepts changes through PRs: git switch -c <feat|fix|refactor|chore|docs>/<name>, commit, then open a PR." >&2
  fail=1
fi

# A commit with a hand-written todo file → sync the auto file + TODO.md into the same commit (scripts/todo.mjs).
if [ $fail -eq 0 ] && printf '%s\n' "$staged" | grep -qE '^docs/todo/[a-z]+\.md$'; then
  node scripts/todo.mjs sync >/dev/null && git add -- TODO.md docs/todo/ || fail=1
fi

# Prettier on staged files (hand edits outside VSCode, forgotten formatting), then restage them.
# Runs only when the project has Prettier installed; same extension list as .claude/hooks/format.sh.
if [ $fail -eq 0 ] && [ -e node_modules/.bin/prettier ]; then
  files=()
  unstaged=$(git diff --name-only -z | tr '\0' '\n')
  while IFS= read -r -d '' f; do
    case "$f" in
      *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.json|*.css|*.md|*.yml|*.yaml) ;;
      *) continue ;;
    esac
    if printf '%s\n' "$unstaged" | grep -qxF -- "$f"; then
      # Partially staged: formatting the whole file would pull in unstaged changes, so only check the staged version.
      staged_blob=$(git show ":$f")
      if [ "$(printf '%s' "$staged_blob" | npx --no-install prettier --stdin-filepath "$f" 2>/dev/null)" != "$staged_blob" ]; then
        echo "Partially staged file is not formatted: $f — run: npx prettier --write \"$f\" then git add it again." >&2
        fail=1
      fi
    else
      files+=("$f")
    fi
  done < <(git diff --cached --name-only --diff-filter=ACMR -z)

  if [ ${#files[@]} -gt 0 ]; then
    if npx --no-install prettier --write --ignore-unknown --log-level=warn -- "${files[@]}" >/dev/null; then
      git add -- "${files[@]}"
    else
      echo "Prettier failed (see above): fix the syntax and commit again." >&2
      fail=1
    fi
  fi
fi

exit $fail
